  "test_scenarios": [
    {
      "name": "multi_hop_call_chain",
      "description": "Validates that tracing calls starting from entrypoint main.py -> user_service -> auth_service -> base.py correctly reconstructs the full 3-hop execution flow.",
      "relevant_entity_ids": [
        "py.main.run_pipeline",
        "py.services.user_service.UserService.login_user",
        "py.services.auth_service.AuthService.authenticate_user",
        "py.models.user.UserModel.to_dict",
        "py.models.base.BaseModel.to_dict"
      ],
      "expected_behavior": "Retrieval should return the ordered CALLS chain: py.main.run_pipeline -> UserService.login_user -> AuthService.authenticate_user -> UserModel.to_dict -> BaseModel.to_dict."
    },
    {
      "name": "multi_level_inheritance",
      "description": "Validates that resolving class context for AdminUser traverses multi-level inheritance to pull in both UserModel and BaseModel context.",
      "relevant_entity_ids": [
        "py.models.admin.AdminUser",
        "py.models.user.UserModel",
        "py.models.base.BaseModel"
      ],
      "expected_behavior": "Graph resolution should traverse INHERITS edges AdminUser -> UserModel and UserModel -> BaseModel to construct complete inherited schema and method definitions."
    },
    {
      "name": "interface_implementation",
      "description": "Validates resolution of abstract interfaces and concrete class implementations across Python ABCs and TypeScript interfaces.",
      "relevant_entity_ids": [
        "py.services.auth_service.AuthService",
        "py.interfaces.repository.Repository",
        "ts.services.user_service.UserService",
        "ts.interfaces.repository_interface.Repository"
      ],
      "expected_behavior": "Querying for implementations of Repository should return AuthService in Python and UserService in TypeScript via IMPLEMENTS edges."
    },
    {
      "name": "method_disambiguation",
      "description": "Validates that queries targeting a method named 'validate' accurately differentiate UserModel.validate from AuthService.validate based on AST scope and signature.",
      "relevant_entity_ids": [
        "py.models.user.UserModel.validate",
        "py.services.auth_service.AuthService.validate"
      ],
      "expected_behavior": "Entity extraction and symbol search must distinguish UserModel.validate() (entity validation) from AuthService.validate(token) (token verification) without symbol collision."
    },
    {
      "name": "textual_similarity_no_conflation",
      "description": "Validates that textually/structurally similar functions format_user_record and format_audit_log are retrieved distinctly according to domain semantics.",
      "relevant_entity_ids": [
        "py.utils.formatting.format_user_record",
        "py.utils.formatting.format_audit_log"
      ],
      "expected_behavior": "Embedding vector search combined with graph contextualization must separate user record formatting from system audit log formatting despite high cosine similarity."
    },
    {
      "name": "orphan_file_isolation",
      "description": "Validates that formatting.py is indexed correctly as an isolated module with zero outgoing/incoming CALLS or IMPORTS relationships.",
      "relevant_entity_ids": [
        "py.utils.formatting",
        "py.utils.formatting.format_user_record",
        "py.utils.formatting.format_audit_log",
        "py.utils.formatting.truncate_text"
      ],
      "expected_behavior": "Vector indexing should make utility functions searchable while relationship resolution reports 0 external IMPORTS/CALLS edges connecting formatting.py to the rest of the codebase."
    }
  ]
